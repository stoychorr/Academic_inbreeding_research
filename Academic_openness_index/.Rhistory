library(readxl)
library(dplyr)
library(WDI)
library(dplyr)
library(countrycode)
library(ggplot2)
library(tidyr)
library(purrr)
#mobile doctorate graduates
mbl_doct_grad <- read_excel("mbl_doct_grad.xlsx")
#International net flows of scietific authors
net_flows <- read_excel("net_flows.xlsx")
# Percentage international collaboarations
pct_int_cll <- read_excel("pct_int_cll.xlsx")
#Total researchers
total_researchers <- read_excel("total_researchers.xlsx")
df_final <- list(mbl_doct_grad, net_flows, pct_int_cll, total_researchers) %>%
reduce(full_join, by = "Country")
library(dplyr)
df <- df_final %>%
mutate(
mobile_per_researcher = Mobile_dct_grad / Total_researchers,
net_flows_per_researcher = International_net_flows_of_scientific_authors / Total_researchers
)
df_clean <- df %>%
filter(!is.na(Total_researchers))
df_clean<-na.omit(df_clean)
df_index <- df_clean %>%
mutate(
z_mobile = scale(mobile_per_researcher)[,1],
z_flows  = scale(net_flows_per_researcher)[,1],
z_collab = scale(pct_sc_pub_inv_int_coll)[,1]
)
View(df_index)
View(df)
View(mbl_doct_grad)
View(total_researchers)
df_index <- df_clean %>%
mutate(
z_mobile = scale(mobile_per_researcher)[,1],
z_flows  = scale(net_flows_per_researcher)[,1],
z_collab = scale(pct_sc_pub_inv_int_coll)[,1]
)
df_index <- df_index %>%
mutate(
openness_index = (z_mobile + z_flows + z_collab) / 3
)
# 1) pull latest WB GDP per capita PPP
gdp_wb <- WDI(
country = "all",
indicator = "NY.GDP.PCAP.PP.KD",
start = 2023,
end = 2023,
extra = FALSE
) %>%
transmute(
iso3c = iso2c,   # temporary, will fix below
country_wb = country,
gdp_pc_ppp = NY.GDP.PCAP.PP.KD
)
# WDI returns iso2c as `iso2c`; add iso3c properly if needed
gdp_wb <- WDI(
country = "all",
indicator = "NY.GDP.PCAP.PP.KD",
start = 2023,
end = 2023,
extra = TRUE
) %>%
transmute(
iso3c,
country_wb = country,
gdp_pc_ppp = NY.GDP.PCAP.PP.KD
) %>%
filter(!is.na(iso3c), !is.na(gdp_pc_ppp))
# 2) prepare your dataset
df2 <- df_index %>%
mutate(
iso3c = countrycode(Country, "country.name", "iso3c"),
mobile_per_1000 = 1000 * Mobile_dct_grad / Total_researchers,
flows_per_1000  = 1000 * International_net_flows_of_scientific_authors / Total_researchers
) %>%
filter(!is.na(iso3c))
# optional: fix any country names that countrycode misses
df2$iso3c[df2$Country == "Slovak Republic"] <- "SVK"
df2$iso3c[df2$Country == "Czechia"] <- "CZE"
df2$iso3c[df2$Country == "Turkiye"] <- "TUR"
df2$iso3c[df2$Country == "EU27-from 01/02/2020"] <- NA  # no direct WB match
# 3) merge
dfm <- df2 %>%
left_join(gdp_wb, by = "iso3c")
df_plot <- dfm %>%
filter(!is.na(openness_index), !is.na(gdp_pc_ppp))
library(ggplot2)
library(dplyr)
df_plot <- df_plot %>%
arrange(desc(openness_index)) %>%
mutate(
Country = factor(Country, levels = Country),
highlight = ifelse(Country == "Bulgaria", "Bulgaria", "Other")
)
ggplot(df_plot, aes(x = Country, y = openness_index, fill = highlight)) +
geom_col() +
coord_flip() +
scale_fill_manual(values = c("Bulgaria" = "red", "Other" = "grey70")) +
labs(
title = "Academic Openness Index by Country",
x = "",
y = "Openness Index"
) +
theme_minimal() +
theme(legend.position = "none")
ggplot(df_plot, aes(x = gdp_pc_ppp, y = openness_index)) +
geom_point(aes(color = Country == "Bulgaria"), size = 3) +
geom_smooth(method = "lm", se = FALSE, color = "black") +
scale_color_manual(values = c("TRUE" = "red", "FALSE" = "grey50")) +
scale_x_log10() +
labs(
title = "Academic Openness vs GDP per Capita",
x = "GDP per capita (PPP, log scale)",
y = "Openness Index"
) +
theme_minimal() +
theme(legend.position = "none")
writexl::write_xlsx(df,"index.xls")
writexl::write_xlsx(df,"index.xlsx")
writexl::write_xlsx(df_index,"index.xlsx")
writexl::write_xlsx(df_index,"index.xlsx")
