library(broom)
library(dplyr)
library(ggplot2)
library(forcats)
models <- list(
"Model 1" = g1,
"Model 2" = g2,
"Model 3" = g3,
"Model 4" = g4,
"Model 5" = g_margins
)
df <- bind_rows(lapply(names(models), function(m) {
tidy(models[[m]]) %>% mutate(model = m)
}))
df_plot <- df %>%
filter(term != "(Intercept)") %>%
mutate(
term = recode(term,
"log(Scopus_all + 1)" = "Research productivity",
"ifelse(as.numeric(Time_from_phd_to_FEBA) < 365, 1, 0)" = "Hired within 1 year of PhD",
"as.factor(Gender)1" = "Male",
"as.factor(Academic_title)Гл. ас." = "Chief Assistant",
"as.factor(Academic_title)Доц." = "Associate Professor",
"as.factor(Academic_title)Проф." = "Professor",
"as.factor(Department)Econometrics and statistics" = "Dept: Econometrics and Statistics",
"as.factor(Department)Economics" = "Dept: Economics",
"as.factor(Department)ESG" = "Dept: ESG",
"as.factor(Department)FA" = "Dept: Finance and Accounting",
"as.numeric(International_collaboration)" = "International collaboration",
"as.numeric(Only_national_collab)" = "Only national collaboration",
"as.numeric(Only_institutional_collaboration)" = "Only institutional collaboration"
),
odds_ratio = exp(estimate),
conf.low = exp(estimate - 1.96 * std.error),
conf.high = exp(estimate + 1.96 * std.error)
) %>%
mutate(term = fct_rev(term))
ggplot(df_plot, aes(x = odds_ratio, y = term, shape = model)) +
geom_vline(xintercept = 1, linetype = "dashed", color = "grey50") +
geom_errorbarh(aes(xmin = conf.low, xmax = conf.high), height = 0) +
geom_point(size = 2.8) +
scale_x_log10() +
labs(
title = "Determinants of Inbred Hiring",
subtitle = "Odds ratios with 95% confidence intervals",
x = "Odds ratio",
y = NULL,
shape = NULL
) +
theme_minimal(base_size = 13) +
theme(
legend.position = "bottom",
panel.grid.minor = element_blank(),
panel.grid.major.y = element_blank()
)
